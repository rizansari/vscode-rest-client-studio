{
  "name": "rest-client-studio",
  "displayName": "REST Client Studio",
  "description": "A visual editor for REST Client .http / .rest files: edit, run, environments, auth, cookies, history and code generation.",
  "version": "0.1.0",
  "publisher": "RizwanAnsari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizansari/vscode-rest-client-studio.git"
  },
  "bugs": {
    "url": "https://github.com/rizansari/vscode-rest-client-studio/issues"
  },
  "homepage": "https://github.com/rizansari/vscode-rest-client-studio#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "REST",
    "http",
    "rest-client",
    "postman",
    "api"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:http"
  ],
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "Http",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "restClientStudio.editor",
        "displayName": "REST Client Studio",
        "selector": [
          {
            "filenamePattern": "*.http"
          },
          {
            "filenamePattern": "*.rest"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "restClientStudio.open",
        "title": "Open in REST Client Studio",
        "category": "REST Client Studio",
        "icon": "$(preview)"
      },
      {
        "command": "restClientStudio.openAsText",
        "title": "Open as Text",
        "category": "REST Client Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "restClientStudio.clearHistory",
        "title": "Clear Request History",
        "category": "REST Client Studio"
      },
      {
        "command": "restClientStudio.clearCookies",
        "title": "Clear Cookies",
        "category": "REST Client Studio"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "restClientStudio.open",
          "when": "resourceExtname =~ /^\\.(http|rest)$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "restClientStudio.openAsText",
          "when": "activeCustomEditorId == restClientStudio.editor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "restClientStudio.open",
          "when": "resourceExtname =~ /^\\.(http|rest)$/",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "restClientStudio.openAsText",
          "when": "activeCustomEditorId == restClientStudio.editor"
        }
      ]
    },
    "configuration": {
      "title": "REST Client Studio",
      "properties": {
        "restClientStudio.openByDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Open `.http` and `.rest` files in REST Client Studio instead of the text editor. Updates the `workbench.editorAssociations` user setting."
        },
        "restClientStudio.historyLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of requests kept in the Studio history."
        },
        "restClientStudio.responsePane": {
          "type": "string",
          "enum": [
            "bottom",
            "right"
          ],
          "default": "bottom",
          "description": "Where the response pane is placed relative to the request editor."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "vitest run",
    "test:e2e": "npm run build && node test/e2e/runTest.mjs",
    "vscode:prepublish": "node esbuild.mjs --production && vite build --config webview/vite.config.mts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.5",
    "@types/aws4": "^1.11.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/tough-cookie": "^4.0.5",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vscode/codicons": "^0.0.36",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.1.1",
    "@xmldom/xmldom": "^0.8.10",
    "aws4": "^1.13.2",
    "codemirror": "^6.0.1",
    "combined-stream": "^1.0.8",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "encodeurl": "^1.0.2",
    "esbuild": "^0.25.12",
    "fs-extra": "^11.2.0",
    "got": "^11.8.6",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "httpsnippet": "^3.0.10",
    "iconv-lite": "^0.6.3",
    "jsdom": "^25.0.1",
    "jsonc-parser": "^3.3.1",
    "jsonpath-plus": "^10.0.0",
    "mime-types": "^2.1.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tough-cookie": "^4.1.4",
    "tough-cookie-file-store": "^2.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "xpath": "^0.0.34",
    "yargs-parser": "^21.1.1",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "httpsnippet": {
      "form-data": "^4.0.6"
    }
  }
}
